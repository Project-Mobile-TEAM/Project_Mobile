# Supabase metadata; copy .env.example to .env and replace placeholders.
# Android never receives these values. Spring Boot uses JDBC, not Supabase keys.
SUPABASE_PROJECT_ID=your-project-ref-id
SUPABASE_URL=https://your-project-ref-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Copy the SESSION pooler hostname and username from the Connect dialog.
DB_HOST=your-pooler-host.pooler.supabase.com
DB_PORT_SESSION=5432
DB_PORT_TRANSACTION=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref-id
DB_PASSWORD=replace-with-database-password

# Expand these references when loading .env; Spring Boot does not load .env itself.
FLYWAY_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT_SESSION}/${DB_NAME}?sslmode=require
FLYWAY_USER=${DB_USER}
FLYWAY_PASSWORD=${DB_PASSWORD}
FLYWAY_LOCATIONS=filesystem:backend/src/main/resources/db/migration
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT_TRANSACTION}/${DB_NAME}?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# Demo only: BCrypt hash (cost >= 10) of a locally chosen password, never a default.
# Set the Flyway placeholder via FLYWAY_PLACEHOLDERS_DEMOPASSWORDHASH.
DEMO_PASSWORD_HASH=replace-with-bcrypt-hash-of-local-demo-password
