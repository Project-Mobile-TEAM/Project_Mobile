<?xml version="1.0" encoding="UTF-8"?>
<!-- Backend Maven độc lập; Java 17 và Spring Boot 3 theo yêu cầu môn học. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>
    <groupId>com.utechat</groupId>
    <artifactId>backend</artifactId>
    <version>1.0.0</version>
    <properties>
        <!-- Biên dịch bytecode Java 17 dù máy lập trình có JDK mới hơn. -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <!-- REST JSON, JDBC/HikariCP và driver PostgreSQL phục vụ health probe. -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <!-- Flyway tự động áp dụng các migration (V1, V3, V4...) khi backend khởi động; kết nối qua port 5432 (Session/Direct). -->
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
        <!-- Chỉ đọc .env ở máy phát triển; secret không được đóng vào artifact. -->
        <dependency><groupId>io.github.cdimascio</groupId><artifactId>dotenv-java</artifactId><version>3.1.0</version></dependency>
        <!-- Spring Security: BCrypt và chuỗi lọc JWT không trạng thái (ADR-006, ADR-018). -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
        <!-- JJWT 0.12.6: ký/kiểm HMAC-SHA256 cho JWT 30 ngày và token tạm. -->
        <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-api</artifactId><version>0.12.6</version></dependency>
        <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-impl</artifactId><version>0.12.6</version><scope>runtime</scope></dependency>
        <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-jackson</artifactId><version>0.12.6</version><scope>runtime</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <!-- H2 chỉ kiểm thử JDBC/transaction của helper sự kiện; không thay thế kiểm thử schema PostgreSQL. -->
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
        <!-- Chỉ test hợp đồng client Android qua HTTP thật; cùng phiên bản với app, không đưa vào JAR production. -->
        <dependency><groupId>com.squareup.retrofit2</groupId><artifactId>retrofit</artifactId><version>2.11.0</version><scope>test</scope></dependency>
        <dependency><groupId>com.squareup.retrofit2</groupId><artifactId>converter-gson</artifactId><version>2.11.0</version><scope>test</scope></dependency>
        <!-- Giữ Gson đúng bản transitive của app, tránh BOM backend đổi hành vi JSON trong gate client. -->
        <dependency><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.10.1</version><scope>test</scope></dependency>
        <dependency><groupId>com.squareup.okhttp3</groupId><artifactId>okhttp</artifactId><version>4.12.0</version><scope>test</scope></dependency>
        <!-- Chạy trực tiếp các test JUnit4 thuần Java đang có của app trong cổng nghiệm thu client. -->
        <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
        <!-- PostgreSQL thật chạy nhúng cho test tích hợp: kiểm SQL trên đúng schema V1, không cần Docker hay Supabase. -->
        <dependency><groupId>io.zonky.test</groupId><artifactId>embedded-postgres</artifactId><version>2.0.7</version><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Đóng gói JAR chạy được bằng java -jar, không phụ thuộc Android Gradle. -->
            <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
        </plugins>
    </build>
</project>
