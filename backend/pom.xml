<?xml version="1.0" encoding="UTF-8"?>
<!-- Backend Maven độc lập; Java 17 và Spring Boot 3 theo yêu cầu môn học. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>
    <groupId>com.utechat</groupId>
    <artifactId>backend</artifactId>
    <version>1.0.0</version>
    <properties>
        <!-- Biên dịch bytecode Java 17 dù máy lập trình có JDK mới hơn. -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <!-- REST JSON, JDBC/HikariCP và driver PostgreSQL phục vụ health probe. -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <!-- Chỉ đọc .env ở máy phát triển; secret không được đóng vào artifact. -->
        <dependency><groupId>io.github.cdimascio</groupId><artifactId>dotenv-java</artifactId><version>3.1.0</version></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Đóng gói JAR chạy được bằng java -jar, không phụ thuộc Android Gradle. -->
            <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
        </plugins>
    </build>
</project>
