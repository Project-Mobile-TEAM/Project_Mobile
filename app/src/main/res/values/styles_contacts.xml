<?xml version="1.0" encoding="utf-8"?>
<!-- Nút dạng chip của danh bạ theo Figma: hình nhìn cao 32dp nhưng vùng chạm 44dp (inset 6dp trên/dưới). -->
<resources>
    <style name="Widget.UTEChat.Chip" parent="Widget.Material3.Button">
        <item name="android:layout_height">44dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">6dp</item>
        <item name="android:insetBottom">6dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <!-- Chip phụ ("Xóa"): nền xám nhạt, chữ thường. -->
    <style name="Widget.UTEChat.Chip.Tonal">
        <item name="backgroundTint">@color/ute_avatar_bg</item>
        <item name="android:textColor">@color/ute_text</item>
    </style>
    <!-- Chip viền ("Hủy lời mời", "Bỏ chặn"): nền trong, viền và chữ màu nhấn. -->
    <style name="Widget.UTEChat.Chip.Outlined">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/ute_accent</item>
        <item name="strokeWidth">1.2dp</item>
        <item name="android:textColor">@color/ute_accent</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
</resources>
