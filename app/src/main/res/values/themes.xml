<?xml version="1.0" encoding="utf-8"?>
<!-- Material3 DayNight tự chuyển sáng/tối theo hệ thống; màu lấy từ @color/ute_* nên một theme dùng cho cả hai chế độ. -->
<resources>
    <style name="Base.Theme.UTEChat" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Biểu tượng thanh trạng thái: tối trên nền sáng (bản tối ghi đè ở values-night). -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- Màu nhấn chính. -->
        <item name="colorPrimary">@color/ute_accent</item>
        <item name="colorOnPrimary">@color/ute_on_accent</item>
        <!-- Nền màn hình và bề mặt: các layout dùng ?attr/colorSurface nên nền khớp thiết kế. -->
        <item name="android:colorBackground">@color/ute_background</item>
        <item name="colorSurface">@color/ute_background</item>
        <item name="colorOnSurface">@color/ute_text</item>
        <item name="colorOnSurfaceVariant">@color/ute_text_secondary</item>
        <!-- Viền thẻ và đường kẻ mảnh. -->
        <item name="colorOutline">@color/ute_border</item>
        <item name="colorOutlineVariant">@color/ute_border</item>
        <!-- Màu lỗi: viền và chữ báo lỗi của ô nhập. -->
        <item name="colorError">@color/ute_error</item>
        <!-- Font Poppins toàn app (hỗ trợ dấu tiếng Việt); cần cả hai thuộc tính cho View thường và AppCompat/Material. -->
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="actionMenuTextAppearance">@style/TextAppearance.UTEChat.MenuAction</item>
        <item name="actionMenuTextColor">@color/ute_on_bar</item>
        <item name="toolbarStyle">@style/Widget.UTEChat.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Widget.UTEChat.BottomNav</item>
    </style>
    <!-- Thanh tiêu đề theo Figma: nền xanh đậm, chữ và icon trắng, tiêu đề Poppins Medium 20sp. -->
    <style name="Widget.UTEChat.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/ute_bar</item>
        <item name="titleTextColor">@color/ute_on_bar</item>
        <item name="navigationIconTint">@color/ute_on_bar</item>
        <item name="titleTextAppearance">@style/TextAppearance.UTEChat.ToolbarTitle</item>
    </style>
    <style name="TextAppearance.UTEChat.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/ute_on_bar</item>
    </style>
    <!-- Thanh tab theo Figma: nền trắng có viền trên, chỉ báo xám nhạt, mục đang chọn chữ đậm màu chính. -->
    <style name="Widget.UTEChat.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.UTEChat.BottomNav.Indicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.UTEChat.TabActive</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.UTEChat.Tab</item>
    </style>
    <style name="Widget.UTEChat.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/ute_avatar_bg</item>
    </style>
    <style name="TextAppearance.UTEChat.Tab" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TextAppearance.UTEChat.TabActive" parent="TextAppearance.UTEChat.Tab">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>
    <!-- Chữ "Lưu" trên thanh tiêu đề: không viết hoa toàn bộ, màu nhấn (theo Figma). -->
    <style name="TextAppearance.UTEChat.MenuAction" parent="TextAppearance.Material3.LabelLarge">
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Theme.UTEChat" parent="Base.Theme.UTEChat" />
</resources>
