<?xml version="1.0" encoding="utf-8"?>
<!-- Graph gốc do nhóm trưởng quản lý, feature chỉ thêm destination vào graph con. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph" app:startDestination="@id/splashFragment">
    <fragment android:id="@+id/splashFragment" android:name="com.utechat.ui.splash.SplashFragment">
        <!-- Hoàn tất/bỏ qua probe thì sang Auth và bỏ Splash để Back không chạy probe lại. -->
        <action android:id="@+id/action_splash_to_auth" app:destination="@id/nav_auth"
            app:popUpTo="@id/splashFragment" app:popUpToInclusive="true" />
    </fragment>
    <include app:graph="@navigation/nav_auth" />
    <include app:graph="@navigation/nav_chat" />
    <include app:graph="@navigation/nav_contacts" />
    <include app:graph="@navigation/nav_profile" />
</navigation>
