<?xml version="1.0" encoding="utf-8"?>
<!-- Graph gốc do nhóm trưởng quản lý, feature chỉ thêm destination vào graph con. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph" app:startDestination="@id/splashFragment">
    <fragment android:id="@+id/splashFragment" android:name="com.utechat.ui.splash.SplashFragment">
        <!-- Hoàn tất/bỏ qua probe thì sang Auth và bỏ Splash để Back không chạy probe lại. -->
        <action android:id="@+id/action_splash_to_auth" app:destination="@id/nav_auth"
            app:popUpTo="@id/splashFragment" app:popUpToInclusive="true" />
    </fragment>
    <include app:graph="@navigation/nav_auth" />
    <include app:graph="@navigation/nav_chat" />
    <include app:graph="@navigation/nav_contacts" />
    <include app:graph="@navigation/nav_profile" />

    <!-- Màn hình cuộc gọi thoại WebRTC 1-1: mở qua action_global_call từ ChatRoom hoặc thông báo cuộc gọi đến. -->
    <fragment
        android:id="@+id/callFragment"
        android:name="com.utechat.ui.call.CallFragment">
        <argument android:name="callId" app:argType="string" app:nullable="true" android:defaultValue="@null" />
        <argument android:name="conversationId" app:argType="string" app:nullable="true" android:defaultValue="@null" />
        <argument android:name="peerUserId" app:argType="string" app:nullable="true" android:defaultValue="@null" />
        <argument android:name="peerName" app:argType="string" app:nullable="true" android:defaultValue="@null" />
        <argument android:name="peerAvatarUrl" app:argType="string" app:nullable="true" android:defaultValue="@null" />
        <argument android:name="peerPhone" app:argType="string" app:nullable="true" android:defaultValue="@null" />
    </fragment>

    <action
        android:id="@+id/action_global_call"
        app:destination="@id/callFragment"
        app:launchSingleTop="true" />
</navigation>
