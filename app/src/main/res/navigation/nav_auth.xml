<?xml version="1.0" encoding="utf-8"?>
<!-- Nhóm auth chỉ sửa graph con này, không sửa graph của các nhóm khác. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_auth" app:startDestination="@id/loginFragment">
    <fragment android:id="@+id/loginFragment" android:name="com.utechat.ui.auth.LoginFragment">
        <!-- Đăng nhập xong (hoặc nút xem mẫu Debug) vào tab chat; xóa Auth khỏi back stack. -->
        <action android:id="@+id/action_login_to_main" app:destination="@id/nav_chat"
            app:popUpTo="@id/nav_auth" app:popUpToInclusive="true" />
        <!-- Bấm "Đăng ký" sang bước nhập số điện thoại. -->
        <action android:id="@+id/action_login_to_register" app:destination="@id/registerFragment" />
    </fragment>
    <fragment android:id="@+id/registerFragment" android:name="com.utechat.ui.auth.RegisterFragment">
        <!-- Gửi OTP thành công thì sang bước nhập mã. -->
        <action android:id="@+id/action_register_to_otp" app:destination="@id/otpFragment" />
    </fragment>
    <fragment android:id="@+id/otpFragment" android:name="com.utechat.ui.auth.OtpFragment">
        <!-- OTP đúng thì sang bước hoàn tất hồ sơ. -->
        <action android:id="@+id/action_otp_to_complete" app:destination="@id/completeProfileFragment" />
    </fragment>
    <fragment android:id="@+id/completeProfileFragment" android:name="com.utechat.ui.auth.CompleteProfileFragment">
        <!-- Tạo tài khoản xong vào app; xóa toàn bộ luồng Auth khỏi back stack. -->
        <action android:id="@+id/action_complete_to_main" app:destination="@id/nav_chat"
            app:popUpTo="@id/nav_auth" app:popUpToInclusive="true" />
    </fragment>
</navigation>
