<?xml version="1.0" encoding="utf-8"?>
<!-- Mỗi hàng hiển thị người dùng và biểu cảm họ đã chọn. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
    android:gravity="center_vertical" android:paddingHorizontal="4dp">
    <TextView android:id="@+id/reaction_avatar"
        android:layout_width="36dp" android:layout_height="36dp" android:gravity="center"
        android:background="@drawable/bg_avatar" android:textColor="@color/ute_avatar_text"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/reaction_name"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginHorizontal="12dp" android:textAppearance="?attr/textAppearanceBodyLarge" />
    <TextView android:id="@+id/reaction_emoji"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" />
</LinearLayout>
