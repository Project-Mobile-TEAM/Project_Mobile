<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình cuộc gọi thoại WebRTC 1-1 DayNight Material 3: mọi nút bấm >= 48dp, hỗ trợ xoay màn hình. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="24dp"
    android:paddingVertical="32dp">

    <!-- Biểu ngữ cảnh báo khi mất ICE tạm thời trong thời gian 60s server grace -->
    <TextView
        android:id="@+id/tvCallBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/ute_warning_bg"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="@string/call_status_reconnecting"
        android:textColor="@color/ute_warning_text"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <!-- Vùng thông tin người nghe/gọi -->
    <LinearLayout
        android:id="@+id/layoutPeerInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/layoutControlsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCallBanner"
        app:layout_constraintVertical_bias="0.38">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="112dp"
            android:layout_height="112dp"
            app:cardBackgroundColor="@color/ute_avatar_bg"
            app:cardCornerRadius="56dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ute_border"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tvPeerInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/ute_avatar_text"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    tools:text="AN" />

                <ImageView
                    android:id="@+id/ivPeerAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/call_avatar_cd"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvPeerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/ute_text"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Nguyễn Văn An" />

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/ute_text_secondary"
            android:textSize="16sp"
            tools:text="Đang gọi…" />

        <TextView
            android:id="@+id/tvCallTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/ute_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="01:24"
            tools:visibility="visible" />

        <!-- Nút dự phòng gọi nhà mạng (ACTION_DIAL) chỉ hiện khi WebRTC lỗi và đã biết SĐT -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialFallback"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="@string/call_action_dial_fallback"
            android:visibility="gone"
            app:icon="@drawable/ic_call"
            app:iconTint="@color/ute_accent"
            app:strokeColor="@color/ute_accent"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Cụm nút điều khiển ở đáy màn hình -->
    <FrameLayout
        android:id="@+id/layoutControlsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Nhóm nút khi có cuộc gọi đến (Nghe máy / Từ chối) -->
        <LinearLayout
            android:id="@+id/layoutIncomingControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRejectCall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:minHeight="56dp"
                android:text="@string/call_action_reject"
                android:textColor="@color/ute_on_accent_fixed"
                app:backgroundTint="@color/ute_error"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_call_end"
                app:iconGravity="textStart"
                app:iconTint="@color/ute_on_accent_fixed" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptCall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:minHeight="56dp"
                android:text="@string/call_action_accept"
                android:textColor="@color/ute_on_accent_fixed"
                app:backgroundTint="@color/ute_success"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_call"
                app:iconGravity="textStart"
                app:iconTint="@color/ute_on_accent_fixed" />
        </LinearLayout>

        <!-- Nhóm nút khi đang gọi đi / kết nối / đàm thoại (Tắt mic / Loa ngoài / Kết thúc) -->
        <LinearLayout
            android:id="@+id/layoutActiveControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleMute"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/call_action_mute"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_mic_off"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleSpeaker"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/call_action_speaker"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_speaker"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEndCall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="56dp"
                android:text="@string/call_action_end"
                android:textColor="@color/ute_on_accent_fixed"
                app:backgroundTint="@color/ute_error"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_call_end"
                app:iconGravity="textStart"
                app:iconTint="@color/ute_on_accent_fixed" />
        </LinearLayout>

        <!-- Nút Đóng khi cuộc gọi đã kết thúc -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseCall"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="@string/call_action_close"
            android:visibility="gone"
            app:cornerRadius="26dp" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
