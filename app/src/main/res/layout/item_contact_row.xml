<?xml version="1.0" encoding="utf-8"?>
<!-- Một hàng theo Figma: avatar 44dp, tên + dòng phụ, tối đa hai chip thao tác. Adapter chọn chip nào hiện. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingHorizontal="16dp" android:paddingVertical="10dp">

    <TextView android:id="@+id/avatar" android:layout_width="44dp" android:layout_height="44dp"
        android:background="@drawable/bg_avatar" android:gravity="center" android:importantForAccessibility="no"
        android:fontFamily="@font/poppins_semibold" android:textSize="16sp" android:textColor="@color/ute_avatar_text" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="16dp" android:layout_marginEnd="8dp" android:orientation="vertical">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="16sp" android:textColor="?attr/colorOnSurface" />
        <TextView android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton android:id="@+id/chip_filled" style="@style/Widget.UTEChat.Chip"
        android:layout_width="wrap_content" android:layout_height="44dp" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/chip_tonal" style="@style/Widget.UTEChat.Chip.Tonal"
        android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="8dp" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/chip_outlined" style="@style/Widget.UTEChat.Chip.Outlined"
        android:layout_width="wrap_content" android:layout_height="44dp" android:visibility="gone" />
    <!-- Menu phụ giữ lối chặn người lạ/bạn bè mà không thêm một chip dài vào hàng kết quả. -->
    <ImageButton android:id="@+id/actions" android:layout_width="48dp" android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_more" android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/contacts_actions" android:visibility="gone" />
</LinearLayout>
