<?xml version="1.0" encoding="utf-8"?>
<!-- Màn đăng nhập theo Figma. Gốc ConstraintLayout; ScrollView chiếm cả màn để bàn phím/xoay ngang không che nút. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Khối đầu: logo, tên, khẩu hiệu. -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:background="@drawable/bg_login_header" android:paddingTop="14dp" android:paddingBottom="30dp">
                <ImageView android:layout_width="96dp" android:layout_height="96dp" android:layout_marginTop="14dp"
                    android:src="@drawable/logo_ute" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/auth_brand"
                    android:textAppearance="@style/TextAppearance.UTEChat.Heading" android:textSize="32sp"
                    android:textColor="@color/ute_on_bar" android:fontFamily="@font/poppins" android:textStyle="bold" android:accessibilityHeading="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/auth_tagline"
                    android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="#D9FFFFFF" />
            </LinearLayout>

            <!-- Form: số điện thoại (tiền tố +84), mật khẩu có nút hiện/ẩn. -->
            <!-- Figma cập nhật: nhãn nằm trên ô (không nổi trên viền), ô cao 50dp, lề 20dp. -->
            <TextView style="@style/Widget.UTEChat.FieldLabelAbove" android:layout_marginTop="32dp"
                android:labelFor="@id/et_phone" android:text="@string/auth_hint_phone" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_phone"
                style="@style/Widget.UTEChat.InputLayout.LabelAbove" android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_phone"
                    style="@style/Widget.UTEChat.EditCompact"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="phone" android:maxLength="14" android:autofillHints="phoneNational" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/Widget.UTEChat.FieldLabelAbove" android:layout_marginTop="16dp"
                android:labelFor="@id/et_password" android:text="@string/auth_hint_password" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_password"
                style="@style/Widget.UTEChat.InputLayout.LabelAbove" android:layout_width="match_parent" android:layout_height="wrap_content"
                app:endIconMode="password_toggle" app:endIconDrawable="@drawable/ic_password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_password"
                    style="@style/Widget.UTEChat.EditCompact"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textPassword" android:autofillHints="password" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:id="@+id/tv_second_factor_hint" android:visibility="gone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="16dp"
                android:text="@string/auth_two_factor_hint" android:textAppearance="?attr/textAppearanceBodyMedium" />
            <TextView android:id="@+id/tv_code_label" style="@style/Widget.UTEChat.FieldLabelAbove" android:visibility="gone"
                android:layout_marginTop="12dp" android:labelFor="@id/et_code" android:text="@string/auth_two_factor_code" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_code" android:visibility="gone"
                style="@style/Widget.UTEChat.InputLayout.LabelAbove" android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_code"
                    style="@style/Widget.UTEChat.EditCompact"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapCharacters|textNoSuggestions" android:maxLength="12" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_login"
                style="@style/Widget.UTEChat.PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="24dp"
                android:minHeight="50dp" app:cornerRadius="12dp" android:text="@string/auth_login" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_forgot"
                    style="@style/Widget.UTEChat.LinkButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:text="@string/auth_forgot_link" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_otp_login"
                    style="@style/Widget.UTEChat.LinkButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:text="@string/auth_otp_login_link" />
            </LinearLayout>

            <!-- Chỉ hiện trong Debug; đây là xem mẫu, không phải đăng nhập thật. -->
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_preview"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:layout_gravity="center_horizontal" android:text="@string/preview_button" />

            <!-- Đẩy dòng "Chưa có tài khoản?" xuống đáy màn hình. -->
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:orientation="horizontal" android:paddingBottom="24dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/auth_no_account" android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_go_register"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:text="@string/auth_register" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
