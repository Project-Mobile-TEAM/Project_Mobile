<?xml version="1.0" encoding="utf-8"?>
<!-- Đăng ký bước 2: nhập OTP 6 số. Gốc ConstraintLayout phẳng. Sáu ô là TextView chỉ để hiển thị; một EditText trong suốt phủ lên nhận phím. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="0dp" android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back" app:navigationContentDescription="@string/auth_back"
        app:title="@string/auth_otp_title" />
    <View android:id="@+id/divider" android:layout_width="0dp" android:layout_height="1dp"
        android:background="@color/ute_border" app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/divider" app:layout_constraintBottom_toTopOf="@id/btn_confirm"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/auth_otp_heading"
                android:textAppearance="@style/TextAppearance.UTEChat.Heading" android:accessibilityHeading="true" />
            <TextView android:id="@+id/tv_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="horizontal" android:weightSum="6">
                    <TextView android:id="@+id/otp_1" style="@style/Widget.UTEChat.OtpBox" />
                    <TextView android:id="@+id/otp_2" style="@style/Widget.UTEChat.OtpBox" />
                    <TextView android:id="@+id/otp_3" style="@style/Widget.UTEChat.OtpBox" />
                    <TextView android:id="@+id/otp_4" style="@style/Widget.UTEChat.OtpBox" />
                    <TextView android:id="@+id/otp_5" style="@style/Widget.UTEChat.OtpBox" />
                    <TextView android:id="@+id/otp_6" style="@style/Widget.UTEChat.OtpBox" />
                </LinearLayout>
                <!-- Chữ trong suốt và không có con trỏ: người dùng chỉ thấy sáu ô phía dưới. -->
                <EditText android:id="@+id/et_code" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@null" android:inputType="number" android:maxLength="6"
                    android:textColor="@android:color/transparent" android:cursorVisible="false"
                    android:autofillHints="smsOTPCode" android:contentDescription="@string/auth_otp_input"
                    android:importantForAutofill="yes" />
            </FrameLayout>

            <TextView android:id="@+id/tv_error" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center" android:visibility="gone"
                android:textColor="?attr/colorError" android:textAppearance="?attr/textAppearanceBodyMedium" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/auth_otp_no_code" android:textColor="?attr/colorOnSurfaceVariant" />
                <!-- Bấm được khi hết đếm ngược; trong lúc đếm hiện "Gửi lại sau mm:ss". -->
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_resend"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:enabled="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton android:id="@+id/btn_confirm"
        style="@style/Widget.UTEChat.PrimaryButton" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:enabled="false" android:text="@string/auth_confirm"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
