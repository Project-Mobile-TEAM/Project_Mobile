<?xml version="1.0" encoding="utf-8"?>
<!-- Tab Tin nhắn (Figma "L · 2 · Tin nhắn", "L · 8 · Mất kết nối", "L · 9/10 · Tìm kiếm"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="@string/title_chats" />

    <!-- Ô tìm kiếm nằm chung nền xanh với thanh tiêu đề. -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/ute_bar" android:paddingHorizontal="16dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
            android:background="@drawable/bg_search_field" android:gravity="center_vertical" android:paddingStart="12dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_search"
                android:importantForAccessibility="no" app:tint="@color/ute_text_secondary" />
            <EditText android:id="@+id/search" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginStart="10dp" android:background="@null"
                android:hint="@string/chat_search_hint" android:textColorHint="@color/ute_text_secondary"
                android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:inputType="text"
                android:imeOptions="actionSearch" android:maxLines="1" android:importantForAutofill="no" />
            <ImageButton android:id="@+id/clear" android:layout_width="44dp" android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_close"
                android:contentDescription="@string/chat_search_clear" android:visibility="gone"
                app:tint="@color/ute_text_secondary" />
        </LinearLayout>
    </FrameLayout>

    <include android:id="@+id/ws" layout="@layout/view_ws_status_banner" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingBottom="88dp" />

        <!-- Trạng thái rỗng dùng chung: chưa có hội thoại, hoặc tìm không có kết quả. -->
        <LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:paddingHorizontal="32dp"
            android:paddingBottom="80dp" android:visibility="gone" android:accessibilityLiveRegion="polite">
            <FrameLayout android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_avatar">
                <ImageView android:id="@+id/empty_icon" android:layout_width="32dp" android:layout_height="32dp"
                    android:layout_gravity="center" android:src="@drawable/ic_search" android:importantForAccessibility="no"
                    app:tint="@color/ute_text_secondary" />
            </FrameLayout>
            <TextView android:id="@+id/empty_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center" android:textSize="17sp"
                android:fontFamily="@font/poppins_semibold" android:textColor="?attr/colorOnSurface" />
            <TextView android:id="@+id/empty_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center" android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fab"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end"
            android:layout_margin="16dp" android:src="@drawable/ic_edit" android:contentDescription="@string/chat_new"
            app:backgroundTint="?attr/colorOnSurface" app:tint="?attr/colorSurface" />
    </FrameLayout>
</LinearLayout>
