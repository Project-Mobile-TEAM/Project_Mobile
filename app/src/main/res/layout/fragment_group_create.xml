<?xml version="1.0" encoding="utf-8"?>
<!-- Tạo nhóm (Figma "L · 8 · Tạo nhóm"): tên nhóm, chọn thành viên, nút Tạo nhóm (n) ở đáy. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="@string/group_create_title"
        app:navigationIcon="@drawable/ic_arrow_back" app:navigationContentDescription="@string/chat_back" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true"
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout android:id="@+id/title_layout"
        style="@style/Widget.UTEChat.InputLayout" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="16dp" android:hint="@string/group_name"
        app:counterEnabled="true" app:counterMaxLength="50">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textCapSentences" android:maxLines="1" android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView android:id="@+id/selected" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="28dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:textAppearance="@style/TextAppearance.UTEChat.Section" android:accessibilityHeading="true" />

    <com.google.android.material.card.MaterialCardView style="@style/Widget.UTEChat.Card"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginHorizontal="16dp">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/friends"
            android:layout_width="match_parent" android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:gravity="center" android:text="@string/chat_no_friends"
        android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />

    <com.google.android.material.button.MaterialButton android:id="@+id/create" style="@style/Widget.UTEChat.PrimaryButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" />
</LinearLayout>
