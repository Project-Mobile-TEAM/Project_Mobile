<?xml version="1.0" encoding="utf-8"?>
<!-- Quên mật khẩu bước 1: nhập số điện thoại đã đăng ký để nhận OTP. Gốc ConstraintLayout phẳng. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="0dp" android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back" app:navigationContentDescription="@string/auth_back"
        app:title="@string/auth_forgot_title" />
    <View android:id="@+id/divider" android:layout_width="0dp" android:layout_height="1dp"
        android:background="@color/ute_border" app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/divider" app:layout_constraintBottom_toTopOf="@id/btn_send"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/tv_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/auth_forgot_heading"
                android:textAppearance="@style/TextAppearance.UTEChat.Heading" android:accessibilityHeading="true" />
            <TextView android:id="@+id/tv_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/auth_forgot_subtitle"
                android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_phone"
                style="@style/Widget.UTEChat.InputLayout" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:hint="@string/auth_hint_phone" app:prefixText="+84">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_phone"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="phone" android:maxLength="14" android:autofillHints="phoneNational" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton android:id="@+id/btn_send"
        style="@style/Widget.UTEChat.PrimaryButton" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:text="@string/auth_send_code"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
