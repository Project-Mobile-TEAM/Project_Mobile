<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView giữ nút truy cập được khi xoay ngang hoặc tăng cỡ chữ hệ thống. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="?attr/colorSurface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_vertical" android:padding="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="?attr/colorPrimary"
            android:textAppearance="?attr/textAppearanceHeadlineLarge" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="@string/probe_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" android:accessibilityHeading="true"
            android:textColor="?attr/colorOnSurface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/probe_subtitle"
            android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurfaceVariant" />
        <!-- Trạng thái có chữ và live region, không chỉ dựa vào màu xanh/đỏ. -->
        <TextView android:id="@+id/server_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="32dp" android:padding="16dp"
            android:text="@string/probe_server_wait" android:textAppearance="?attr/textAppearanceTitleMedium"
            android:accessibilityLiveRegion="polite" android:textColor="?attr/colorOnSurface" />
        <TextView android:id="@+id/database_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="16dp"
            android:text="@string/probe_db_wait" android:textAppearance="?attr/textAppearanceTitleMedium"
            android:accessibilityLiveRegion="polite" android:textColor="?attr/colorOnSurface" />
        <ProgressBar android:id="@+id/progress" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="20dp" />
        <TextView android:id="@+id/status_message" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="@string/probe_checking" android:textAppearance="?attr/textAppearanceBodyMedium"
            android:accessibilityLiveRegion="polite" android:textColor="?attr/colorOnSurfaceVariant" />
        <!-- Mỗi nút tối thiểu48dp; có lối thử lại và tiếp tục ngoại tuyến khi mạng lỗi. -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_retry"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="24dp" android:text="@string/action_retry" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_continue_offline"
            style="?attr/borderlessButtonStyle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/action_offline_continue" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
