<?xml version="1.0" encoding="utf-8"?>
<!-- Đích điều hướng có nút quay lại; không triển khai chức năng tìm kiếm/lời mời/chặn ở đây. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/colorSurface">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back" app:navigationContentDescription="@string/contacts_back" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="24dp"
        android:text="@string/contacts_destination_pending" android:textColor="?attr/colorOnSurface" android:textAppearance="?attr/textAppearanceBodyLarge" />
</LinearLayout>
