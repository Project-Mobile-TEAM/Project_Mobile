<?xml version="1.0" encoding="utf-8"?>
<!-- Mốc ngày ("Hôm nay") đầu mỗi ngày trong phòng chat; ẩn khi tin cùng ngày với tin trước. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:visibility="gone">
    <TextView android:id="@+id/date_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:background="@drawable/bg_pill"
        android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant" android:accessibilityHeading="true" />
</FrameLayout>
