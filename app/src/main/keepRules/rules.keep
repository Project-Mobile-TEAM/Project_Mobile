# Quy tắc R8 / ProGuard cho bản phát hành Release của UTEChat.
# AGP tự động gộp toàn bộ tệp trong src/main/keepRules khi chạy R8 minify.

# Giữ nguyên toàn bộ lớp JNI và callback của WebRTC (io.getstream:stream-webrtc-android) tránh lỗi UnsatisfiedLinkError.
-keep class org.webrtc.** { *; }

# Giữ nguyên các lớp ML Kit Translate để tải mô hình và dịch EN <-> VI ổn định trên bản Release.
-keep class com.google.mlkit.** { *; }

# Giữ Glide AppGlideModule và tên trường JSON của DTO mạng, gồm cảm xúc và nhãn dán Phase 7.
-keep class com.utechat.data.media.UteChatGlideModule { *; }
-keep class com.utechat.data.remote.model.** { *; }
